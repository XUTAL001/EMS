# ==============================================================================
# NEXUS ENTERPRISE MANAGEMENT SYSTEM (NEXUS-EMS)
# Environment Configuration Specification
# ==============================================================================

APP_NAME="NexusEMS Enterprise"
APP_ENV=production
APP_KEY=base64:GENERATE_WITH_ARTISAN_KEY_GENERATE
APP_DEBUG=false
APP_URL=https://ems.tanviralamshifat.me
APP_PORT=8080

# Logging
LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=info

# Database Configuration (MySQL 8.0+)
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=nexus_ems
DB_USERNAME=ems_db_user
DB_PASSWORD=YOUR_STRONG_DATABASE_PASSWORD_HERE
DB_SOCKET=

# Session & Cache
BROADCAST_DRIVER=log
CACHE_DRIVER=file
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync
SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=true

# Security & CORS
SESSION_SECURE_COOKIE=true
SANCTUM_STATEFUL_DOMAINS=ems.yourcompany.com

# Mail Service (Notifications & Resets)
MAIL_MAILER=smtp
MAIL_HOST=smtp.mailgun.org
MAIL_PORT=587
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS="no-reply@yourcompany.com"
MAIL_FROM_NAME="${APP_NAME}"

# File Storage Limits
MAX_UPLOAD_RESUME_KB=5120
MAX_UPLOAD_IMAGE_KB=2048
